# ===========================================================================
# Reembolso-Tecnored — variáveis de ambiente (copie para .env; nunca commite)
# Em hml/main estas variáveis ficam nas Environment Variables do Dokploy.
# ===========================================================================

APP_ENV=local

# Banco. LOCAL: container do override. HML/MAIN: TUPSRVDB02 (um banco e um
# usuário por ambiente, fornecidos pela TI).
DB_URL=postgresql+psycopg://reembolso:reembolso@db:5432/reembolso

# Azure AD (App Registration pedido ao helpdesk). Enquanto não existir,
# deixe vazio e use o login de desenvolvimento abaixo.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8081/auth/callback
AZURE_LOGIN_PROMPT=select_account

# Object IDs dos grupos de segurança (myaccount.microsoft.com/groups).
# Quem não está em nenhum é colaborador.
AZURE_GROUP_GESTOR=
AZURE_GROUP_FINANCEIRO=
AZURE_GROUP_ADMIN=

# SSO via Cloudflare Access (só onde houver acesso externo; nunca em LOCAL).
# CF_ACCESS_TEAM_DOMAIN=tecnored.cloudflareaccess.com

# Cor de fundo por ambiente — SEMPRE entre aspas (o # vira comentário sem elas).
APP_BG_COLOR="#7b2d00"

ENABLE_API_DOCS=true

# Login sem Microsoft, só para desenvolver: http://localhost:8081/dev/login
# Ex.: /dev/login?email=gestor@tecnored.com.br&nome=Gestor&papeis=gestor
# A API NÃO sobe com isso ligado fora de APP_ENV=local.
DEV_LOGIN_ENABLED=true

# Painel de teste ("Ver como"): o admin entra como colaborador, gestor ou financeiro
# de teste e cria/limpa pedidos de demonstração (menu "Painel de teste").
# Só em LOCAL e HML: a API NÃO sobe com isso ligado em APP_ENV=main.
# Admin = grupo admin do Azure ou e-mail em PAINEL_TESTE_ADMINS (separados por vírgula).
# Local sem Microsoft: /dev/login?email=voce@tecnored.com.br&nome=Voce&papeis=admin
PAINEL_TESTE_ENABLED=false
PAINEL_TESTE_ADMINS=

# Arquivos das notas: "local" = volume /data (S3/SharePoint em avaliação pela TI).
STORAGE_BACKEND=local

# Expiração das solicitações devolvidas (lembrete no 5º dia, cancela no 7º),
# roda dentro da API a cada hora.
TAREFAS_AUTOMATICAS=true

VITE_API_URL=http://localhost:8081
FRONTEND_URL=http://localhost:8080
